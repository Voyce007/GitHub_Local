      "calculation": "PRC_CLOSE_DECEASED",
      "capability": "Record Life Events",
      "columns": [],
      "event": "LifeEventRecorded",
      "calc_id": "CAL-11"
    },
    {
      "entity": "ChildcareAccount",
      "entity_id": "ENT-09",
      "owner": "childcare",
      "writer": "customer",
      "calculation": "PRC_CLOSE_DECEASED",
      "capability": "Record Life Events",
      "columns": [
        "STATUS"
      ],
      "event": "LifeEventRecorded",
      "calc_id": "CAL-11"
    }
  ],
